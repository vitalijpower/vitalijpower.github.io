<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0879d1"/>
      <stop offset="100%" stop-color="#18a6e8"/>
    </linearGradient>
  </defs>

  <!-- Фон -->
  <rect width="64" height="64" rx="14" fill="url(#bg)"/>

  <!-- Снежинка -->
  <g
    stroke="#ffffff"
    stroke-width="4"
    stroke-linecap="round"
    stroke-linejoin="round"
    fill="none"
  >
    <!-- вертикаль -->
    <path d="M32 10V54"/>

    <!-- горизонталь -->
    <path d="M13 32H51"/>

    <!-- диагонали -->
    <path d="M18.5 18.5L45.5 45.5"/>
    <path d="M45.5 18.5L18.5 45.5"/>

    <!-- верхние ответвления -->
    <path d="M32 10L27 15"/>
    <path d="M32 10L37 15"/>

    <!-- нижние ответвления -->
    <path d="M32 54L27 49"/>
    <path d="M32 54L37 49"/>

    <!-- левые ответвления -->
    <path d="M13 32L18 27"/>
    <path d="M13 32L18 37"/>

    <!-- правые ответвления -->
    <path d="M51 32L46 27"/>
    <path d="M51 32L46 37"/>

    <!-- диагональные кончики -->
    <path d="M18.5 18.5L19.5 25"/>
    <path d="M18.5 18.5L25 19.5"/>

    <path d="M45.5 18.5L39 19.5"/>
    <path d="M45.5 18.5L44.5 25"/>

    <path d="M18.5 45.5L25 44.5"/>
    <path d="M18.5 45.5L19.5 39"/>

    <path d="M45.5 45.5L44.5 39"/>
    <path d="M45.5 45.5L39 44.5"/>
  </g>

  <!-- Центральная точка -->
  <circle cx="32" cy="32" r="4" fill="#ffffff"/>
</svg>
